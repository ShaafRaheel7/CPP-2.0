#include <iostream>
using namespace std;

#define SIZE 100

class TwoStacks {
    int arr[SIZE];
    int top1, top2;

public:
    TwoStacks() {
        top1 = -1;
        top2 = SIZE;
    }

    // Push to Stack1
    void push1(int x) {
        if (top1 + 1 == top2) {
            cout << "Stack1 Overflow\n";
            return;
        }
        arr[++top1] = x;
        cout << x << " pushed to Stack1\n";
    }

    // Push to Stack2
    void push2(int x) {
        if (top2 - 1 == top1) {
            cout << "Stack2 Overflow\n";
            return;
        }
        arr[--top2] = x;
        cout << x << " pushed to Stack2\n";
    }

    // Pop from Stack1
    void pop1() {
        if (top1 == -1) {
            cout << "Stack1 Underflow\n";
            return;
        }
        cout << arr[top1--] << " popped from Stack1\n";
    }

    // Pop from Stack2
    void pop2() {
        if (top2 == SIZE) {
            cout << "Stack2 Underflow\n";
            return;
        }
        cout << arr[top2++] << " popped from Stack2\n";
    }

    // Display Stack1
    void display1() {
        if (top1 == -1) {
            cout << "Stack1 is empty\n";
            return;
        }
        cout << "Stack1 elements: ";
        for (int i = 0; i <= top1; i++) cout << arr[i] << " ";
        cout << endl;
    }

    // Display Stack2
    void display2() {
        if (top2 == SIZE) {
            cout << "Stack2 is empty\n";
            return;
        }
        cout << "Stack2 elements: ";
        for (int i = SIZE-1; i >= top2; i--) cout << arr[i] << " ";
        cout << endl;
    }
};

int main() {
    TwoStacks ts;

    ts.push1(1);
    ts.push1(2);
    ts.push2(100);
    ts.push2(200);

    ts.display1();
    ts.display2();

    ts.pop1();
    ts.pop2();

    ts.display1();
    ts.display2();

    return 0;
}
